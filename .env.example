# Server
PORT=3001
JWT_SECRET=your-random-secret-here

# Supabase (same as bot)
SUPABASE_URL=your-supabase-url
SUPABASE_SECRET_KEY=your-supabase-service-key

# Telegram (same bot token)
BOT_TOKEN=your-bot-token

# Client URL (Railway domain)
CLIENT_URL=https://helm-finance-web.railway.app

# ── Feature flags (runtime, backend) ─────────────────────────────────────────
# Incoming Payments. Default OFF. When off, every /api/incoming-payments route answers
# 404 before touching the database, so the code is safe to deploy before any of its
# migrations are applied.
#
# PREREQUISITE: do NOT enable this until migrations 048, 049 AND 050 are all applied.
# They are one unit, not three optional steps: the routes select the provenance columns
# added by 049, and the review queue reads the candidates table added by 050. Enabling
# with only 048 applied makes every incoming-payments route fail.
#
# Enabling in production requires explicit owner approval.
INCOMING_PAYMENTS_ENABLED=false

# Payment provider connections (migration 051). Default OFF. When off, every
# /api/payment-connections route and the admin monitor answer 404 before touching the
# database, so the code is safe to deploy before 051 is applied.
#
# PREREQUISITE: apply migration 051 before enabling.
#
# This feature stores NO credentials: the table has no secret column and the API refuses a
# request carrying one. It performs no provider sync and no webhook processing. Adding real
# credential handling later requires a secret store and its own security review - do not
# widen this flag to cover it.
PAYMENT_CONNECTIONS_ENABLED=false

# Payment credential vault (migration 052). Default OFF. When off, every credential route
# answers 404 before touching the database.
#
# PREREQUISITE: apply migration 052 (which requires 051) BEFORE enabling.
#
# SANDBOX ONLY in v1: the API refuses to store a credential against a connection whose
# environment is 'production'. Nothing calls a provider API and no webhook endpoint exists.
#
# Enabling this flag WITHOUT a valid PAYMENT_CREDENTIALS_ENCRYPTION_KEY fails closed: every
# credential write returns 500 credential_vault_not_configured. It never falls back to
# storing plaintext.
PAYMENT_CREDENTIALS_VAULT_ENABLED=false

# AES-256-GCM master key for the credential vault. 32 bytes, base64 (hex also accepted).
# Generate with:  openssl rand -base64 32
#
# This key is the ONLY thing separating a database dump from usable provider secrets. It
# must never be committed, never be stored in the database, and never be logged. Rotating it
# makes every existing ciphertext undecryptable, so rotation needs a re-encryption plan
# before it is attempted.
#
# Leave EMPTY here. Set it only in the deployment environment, and only with explicit owner
# approval alongside the flag.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# Support Center (migration 053). Default OFF. When off, every /api/support and
# /api/admin/support route answers 404 before touching the database.
#
# PREREQUISITE: apply migration 053 before enabling.
#
# v1 is foundation only: no AI replies, no realtime/websocket, no email or Telegram
# delivery, no external helpdesk. Conversations, messages, escalations and a timeline are
# recorded; a human reads and answers them through the admin routes.
#
# WARNING: message bodies are stored in PLAINTEXT and are not redacted. Secrets, API keys
# and card numbers must never be posted into a support thread. Provider credentials belong
# in the vault (052). Add detection/redaction before opening this to a wide audience.
SUPPORT_CENTER_ENABLED=false

# Onboarding (migration 054). Default OFF. When off, every /api/onboarding and
# /api/admin/onboarding route answers 404 before touching the database.
#
# PREREQUISITE: apply migration 054 before enabling.
#
# Two modes ship seeded: quick_business_setup (shown after registration later) and
# full_business_tour (launched manually from a button later). A third feature tour,
# ai_accountant_company_setup, walks company profile, NPWP, NIB, PKP status, KBLI and the
# tax scheme.
#
# v1 is foundation only: no guided-tour UI, no AI calls, no email, no Telegram, no realtime.
# Opening onboarding never provisions a business or starts a trial.
#
# GUIDANCE, NOT ADVICE: onboarding text says where a field is and why it is asked for. It
# never states a tax obligation, rate or filing duty - that stays with the deterministic tax
# engine under human review.
#
# LOCALIZATION-READY, FALLBACK-FIRST: flows and steps carry per-locale JSONB overrides
# (en, id, ru) beside English columns, and any missing translation falls back to English, so
# a partly translated flow always renders. Pass ?locale=ru|id|en. This is NOT platform-wide
# i18n - translating the rest of the product is a separate milestone.
ONBOARDING_ENABLED=false
