# Server
PORT=3001
JWT_SECRET=your-random-secret-here

# Supabase (same as bot)
SUPABASE_URL=your-supabase-url
SUPABASE_SECRET_KEY=your-supabase-service-key

# Telegram (same bot token)
BOT_TOKEN=your-bot-token

# Client URL (Railway domain)
CLIENT_URL=https://helm-finance-web.railway.app

# ── Feature flags (runtime, backend) ─────────────────────────────────────────
# Incoming Payments Foundation (migration 048). Default OFF. When off, every
# /api/incoming-payments route answers 404 and the table is never queried — so the
# code is safe to deploy before 048 is applied. Enabling in production requires
# explicit owner approval.
INCOMING_PAYMENTS_ENABLED=false
