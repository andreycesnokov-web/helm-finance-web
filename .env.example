# Server
PORT=3001
JWT_SECRET=your-random-secret-here

# Supabase (same as bot)
SUPABASE_URL=your-supabase-url
SUPABASE_SECRET_KEY=your-supabase-service-key

# Telegram (same bot token)
BOT_TOKEN=your-bot-token

# Client URL (Railway domain)
CLIENT_URL=https://helm-finance-web.railway.app

# ── Feature flags (runtime, backend) ─────────────────────────────────────────
# Incoming Payments. Default OFF. When off, every /api/incoming-payments route answers
# 404 before touching the database, so the code is safe to deploy before any of its
# migrations are applied.
#
# PREREQUISITE: do NOT enable this until migrations 048, 049 AND 050 are all applied.
# They are one unit, not three optional steps: the routes select the provenance columns
# added by 049, and the review queue reads the candidates table added by 050. Enabling
# with only 048 applied makes every incoming-payments route fail.
#
# Enabling in production requires explicit owner approval.
INCOMING_PAYMENTS_ENABLED=false
