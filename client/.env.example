VITE_BOT_USERNAME=HelmFinanceBot

# CFO AI redesign v2 (_specs/design-v2). Build-time, default OFF.
# OFF: the build is identical to today (no v2 chunk, no new API calls, no new UI).
# ON:  /business/* renders the v2 shell and screens. Rebuild required after changing.
VITE_DESIGN_V2=false

# Email + Password screens (/login, /register, /auth/confirmed, /auth/forgot, /auth/reset). Build-time,
# default OFF. Needs VITE_DESIGN_V2=true and VITE_EMAIL_AUTH_ENABLED=true; server PASSWORD_AUTH_ENABLED=true.
VITE_PASSWORD_AUTH_ENABLED=false
