# Production build settings, read by `vite build` (Railway runs `npm run build`).
# Design v2 is ON in production (owner decision, 3 Oct 2026).
# Rollback without a code change: set the Railway variable VITE_DESIGN_V2=false on the web
# service and redeploy. A real environment variable always overrides this file.
VITE_DESIGN_V2=true
